{
    "name": "matesofmate/common",
    "description": "Common functionality shared across MatesOfMate extensions",
    "type": "library",
    "license": "MIT",
    "keywords": ["matesofmate", "shared", "common", "utilities"],
    "authors": [
        {
            "name": "Johannes Wachter",
            "email": "johannes@sulu.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-simplexml": "*",
        "symfony/process": "^5.4|^6.4|^7.3|^8.0",
        "symfony/finder": "^5.4|^6.4|^7.3|^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^10.0",
        "rector/rector": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "MatesOfMate\\Common\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MatesOfMate\\Common\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": [
            "@composer validate --strict",
            "vendor/bin/rector process --dry-run",
            "vendor/bin/php-cs-fixer fix --dry-run --diff",
            "vendor/bin/phpstan analyse"
        ],
        "fix": [
            "vendor/bin/rector process",
            "vendor/bin/php-cs-fixer fix"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.4.x-dev"
        }
    }
}
